<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kiểm thử -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />

    <!-- Giao diện Avalonia (Lis.App) -->
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />

    <!-- Chụp ảnh giao diện không đầu (tools/Lis.Screenshots) -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.5" />

    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Mã hóa bí mật cục bộ -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />

    <!-- Cổng COM: mở cổng (System.IO.Ports), tên thiết bị USB-serial qua WMI (System.Management, chỉ Windows) -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.0" />
    <PackageVersion Include="System.Management" Version="10.0.0" />

    <!-- Truy cập CSDL PostgreSQL -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />

    <!-- Đọc/ghi Excel -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />

    <!-- Kiểm thử CSDL -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />

    <!-- Tài khoản, đăng nhập -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!--
      Tem barcode, phiếu in (Lis.Reports). PDFsharp giữ ở 6.2.x: bản 6.5.0 trở đi đổi sang
      giấy phép AGPL-3.0, 6.2.4 là bản MIT cuối cùng. PDFtoImage giữ ở 5.2.x vì 5.3.0 trở đi
      cần SkiaSharp 4.x, trong khi Avalonia 12 dùng SkiaSharp 3.119.x.
    -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 kéo theo System.Security.Cryptography.Pkcs 8.0.1 có lỗ hổng đã công bố — nâng tường minh lên bản đã vá. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.14" />

    <!-- Đọc lại PDF trong kiểm thử (tests/Lis.Reports.Tests) -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
