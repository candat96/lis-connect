<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lis.App.ViewModels.Catalog"
             xmlns:conv="using:Lis.App.Services.Converters"
             x:Class="Lis.App.Views.Catalog.CatalogView"
             x:DataType="vm:CatalogViewModel">

    <Grid>
    <Grid ColumnDefinitions="340,*" RowDefinitions="*">

        <!-- Cột trái: bảng dịch vụ có ô lọc -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,16,0">

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Lọc theo mã hoặc tên" />
                <TextBox Name="FilterBox" Text="{Binding FilterText}" PlaceholderText="Nhập mã hoặc tên dịch vụ..." />
            </StackPanel>

            <Border Classes="table" Grid.Row="1">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="80,*,72">
                        <Border Grid.Column="0" Classes="th"><TextBlock Text="Mã" /></Border>
                        <Border Grid.Column="1" Classes="th"><TextBlock Text="Tên dịch vụ" /></Border>
                        <Border Grid.Column="2" Classes="th last"><TextBlock Text="Loại" /></Border>
                    </Grid>
                    <ListBox Grid.Row="1" Classes="table" Name="ServiceList"
                             ItemsSource="{Binding FilteredServices}"
                             SelectedItem="{Binding SelectedService}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceListItemViewModel">
                                <Grid ColumnDefinitions="80,*,72">
                                    <Border Grid.Column="0" Classes="td"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Border>
                                    <Border Grid.Column="1" Classes="td"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="2" Classes="td last"><TextBlock Text="{Binding Loai}" Classes="muted" FontSize="12" /></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
                <Button Content="+ Dịch vụ mới" Command="{Binding NewServiceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Content="📥 Nhập Excel…" Command="{Binding ImportExcelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding CanImportExcel}" />
            </StackPanel>

        </Grid>

        <!-- Cột phải: form sửa dịch vụ + 3 tab -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- Form sửa dịch vụ -->
            <Border CornerRadius="{StaticResource RadiusCard}" Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16">
                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Mã dịch vụ" />
                            <TextBox Text="{Binding EditCode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Tên dịch vụ" />
                            <TextBox Text="{Binding EditName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="Nhóm" />
                            <TextBox Text="{Binding EditGroupName}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Loại mẫu bệnh phẩm" />
                            <ComboBox ItemsSource="{Binding SpecimenTypes}" SelectedItem="{Binding EditSpecimenType}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Kiểu giá trị" />
                            <ComboBox ItemsSource="{Binding ValueTypeOptions}" SelectedItem="{Binding EditValueType}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Đơn vị" />
                            <TextBox Text="{Binding EditUnit}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Classes="label" Text="Số lẻ" />
                            <NumericUpDown Value="{Binding EditDecimals}" Minimum="0" Maximum="4" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Thứ tự in" />
                            <NumericUpDown Value="{Binding EditPrintOrder}" Minimum="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Classes="label" Text="Mã HIS" />
                            <TextBox Text="{Binding EditHisCode}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="Là dịch vụ cha (panel)" IsChecked="{Binding EditIsPanel}" VerticalAlignment="Bottom" />
                        <CheckBox Grid.Column="3" Content="Tự duyệt" IsChecked="{Binding EditAutoApprove}" VerticalAlignment="Bottom" />
                        <CheckBox Grid.Column="4" Content="Đang dùng" IsChecked="{Binding EditActive}" VerticalAlignment="Bottom" />
                    </Grid>

                    <Button Classes="primary" Content="Lưu dịch vụ" Command="{Binding SaveServiceCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />

                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <!-- 3 tab -->
            <TabControl Name="Tabs" Grid.Row="2" Margin="0,16,0,0">

                <TabItem Header="Chỉ số con">
                    <Grid DataContext="{Binding ChildrenEditor}" x:DataType="vm:ChildrenEditorViewModel" RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0">
                        <TextBlock Grid.Row="0" Classes="label" Text="Mã chỉ số con" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Name="AddChildBox" Width="200" Text="{Binding AddChildCode}" PlaceholderText="Mã chỉ số, Enter để thêm" />
                            <Button Content="Thêm" Command="{Binding AddChildCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="error" Text="{Binding ChildError}" Margin="0,4,0,0" />
                        <Border Grid.Row="3" Classes="table" Margin="0,8,0,0">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="100,*,150">
                                    <Border Grid.Column="0" Classes="th"><TextBlock Text="Mã" /></Border>
                                    <Border Grid.Column="1" Classes="th"><TextBlock Text="Tên chỉ số con" /></Border>
                                    <Border Grid.Column="2" Classes="th last"><TextBlock Text="Thứ tự / Xóa" /></Border>
                                </Grid>
                                <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding Children}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChildServiceViewModel">
                                            <Grid ColumnDefinitions="100,*,150">
                                                <Border Grid.Column="0" Classes="td"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" /></Border>
                                                <Border Grid.Column="1" Classes="td"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></Border>
                                                <Border Grid.Column="2" Classes="td last">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="8,2" />
                                                        <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="8,2" />
                                                        <Button Content="Xóa" Command="{Binding RemoveCommand}" Padding="8,2" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Khoảng tham chiếu">
                    <Grid DataContext="{Binding RangesEditor}" x:DataType="vm:RangesEditorViewModel" RowDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
                        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Border Classes="table" HorizontalAlignment="Left">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="92,58,90,58,90,120,70,70,90,90,90,64">
                                    <Border Grid.Column="0" Classes="th"><TextBlock Text="Giới" /></Border>
                                    <Border Grid.Column="1" Classes="th"><TextBlock Text="Tuổi từ" /></Border>
                                    <Border Grid.Column="2" Classes="th"><TextBlock Text="Đơn vị" /></Border>
                                    <Border Grid.Column="3" Classes="th"><TextBlock Text="Tuổi đến" /></Border>
                                    <Border Grid.Column="4" Classes="th"><TextBlock Text="Đơn vị" /></Border>
                                    <Border Grid.Column="5" Classes="th"><TextBlock Text="Máy" /></Border>
                                    <Border Grid.Column="6" Classes="th"><TextBlock Text="Thấp" /></Border>
                                    <Border Grid.Column="7" Classes="th"><TextBlock Text="Cao" /></Border>
                                    <Border Grid.Column="8" Classes="th"><TextBlock Text="Nguy hiểm thấp" /></Border>
                                    <Border Grid.Column="9" Classes="th"><TextBlock Text="Nguy hiểm cao" /></Border>
                                    <Border Grid.Column="10" Classes="th"><TextBlock Text="Khoảng chữ" /></Border>
                                    <Border Grid.Column="11" Classes="th last"><TextBlock Text="" /></Border>
                                </Grid>
                                <ListBox Grid.Row="1" Classes="table" Name="RangeList" ItemsSource="{Binding Ranges}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReferenceRangeRowViewModel">
                                            <Grid ColumnDefinitions="92,58,90,58,90,120,70,70,90,90,90,64">
                                                <Border Grid.Column="0" Classes="td input">
                                                    <ComboBox SelectedItem="{Binding Sex}" HorizontalAlignment="Stretch">
                                                        <ComboBox.Items>
                                                            <x:Null />
                                                            <x:String>M</x:String>
                                                            <x:String>F</x:String>
                                                        </ComboBox.Items>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={x:Static conv:SexLabelConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                                <Border Grid.Column="1" Classes="td input"><TextBox Text="{Binding AgeFromText}" /></Border>
                                                <Border Grid.Column="2" Classes="td input">
                                                    <ComboBox ItemsSource="{x:Static vm:AgeUnitExtensions.All}" SelectedItem="{Binding AgeFromUnit}" HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={x:Static conv:AgeUnitLabelConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                                <Border Grid.Column="3" Classes="td input"><TextBox Text="{Binding AgeToText}" /></Border>
                                                <Border Grid.Column="4" Classes="td input">
                                                    <ComboBox ItemsSource="{x:Static vm:AgeUnitExtensions.All}" SelectedItem="{Binding AgeToUnit}" HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={x:Static conv:AgeUnitLabelConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                                <Border Grid.Column="5" Classes="td input"><ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding Instrument}" HorizontalAlignment="Stretch" /></Border>
                                                <Border Grid.Column="6" Classes="td input"><TextBox Text="{Binding LowText}" /></Border>
                                                <Border Grid.Column="7" Classes="td input"><TextBox Text="{Binding HighText}" /></Border>
                                                <Border Grid.Column="8" Classes="td input"><TextBox Text="{Binding CriticalLowText}" /></Border>
                                                <Border Grid.Column="9" Classes="td input"><TextBox Text="{Binding CriticalHighText}" /></Border>
                                                <Border Grid.Column="10" Classes="td input"><TextBox Text="{Binding TextRange}" /></Border>
                                                <Border Grid.Column="11" Classes="td input last"><Button Content="Xóa" Command="{Binding RemoveCommand}" Padding="8,2" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        </ScrollViewer>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="error" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="+ Thêm dòng" Command="{Binding AddRangeCommand}" />
                            <Button Classes="primary" Content="Lưu khoảng tham chiếu" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Quy đổi định tính">
                    <Grid DataContext="{Binding QualitativeEditor}" x:DataType="vm:QualitativeRulesEditorViewModel" RowDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
                        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Border Classes="table" HorizontalAlignment="Left">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="170,150,150,160,70">
                                    <Border Grid.Column="0" Classes="th"><TextBlock Text="Máy" /></Border>
                                    <Border Grid.Column="1" Classes="th"><TextBlock Text="Giá trị thô" /></Border>
                                    <Border Grid.Column="2" Classes="th"><TextBlock Text="Hiển thị" /></Border>
                                    <Border Grid.Column="3" Classes="th"><TextBlock Text="Cờ" /></Border>
                                    <Border Grid.Column="4" Classes="th last"><TextBlock Text="" /></Border>
                                </Grid>
                                <ListBox Grid.Row="1" Classes="table" Name="QualitativeList" ItemsSource="{Binding Rules}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QualitativeRuleRowViewModel">
                                            <Grid ColumnDefinitions="170,150,150,160,70">
                                                <Border Grid.Column="0" Classes="td input"><ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding Instrument}" HorizontalAlignment="Stretch" /></Border>
                                                <Border Grid.Column="1" Classes="td input"><TextBox Text="{Binding RawValue}" /></Border>
                                                <Border Grid.Column="2" Classes="td input"><TextBox Text="{Binding DisplayValue}" /></Border>
                                                <Border Grid.Column="3" Classes="td input">
                                                    <ComboBox ItemsSource="{x:Static vm:QualitativeRuleRowViewModel.FlagOptions}" SelectedItem="{Binding Flag}" HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={x:Static conv:ResultFlagLabelConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Border>
                                                <Border Grid.Column="4" Classes="td input last"><Button Content="Xóa" Command="{Binding RemoveCommand}" Padding="8,2" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Classes="error" Text="{Binding ErrorMessage}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="+ Thêm dòng" Command="{Binding AddRuleCommand}" />
                            <Button Classes="primary" Content="Lưu quy đổi định tính" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>

        </Grid>

    </Grid>

    <!-- Panel kết quả nhập Excel: hiện khi IsImportResultVisible, che toàn màn như hộp thoại nhẹ. -->
    <Border IsVisible="{Binding IsImportResultVisible}"
            Background="#80000000"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="4" Padding="20" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="Kết quả nhập Excel" FontWeight="SemiBold" FontSize="16" />

                <TextBlock Text="{Binding ImportResultMessage}"
                           IsVisible="{Binding !ImportHasErrors}"
                           TextWrapping="Wrap" />

                <StackPanel IsVisible="{Binding ImportHasErrors}" Spacing="4">
                    <TextBlock Classes="error" Text="Có lỗi, chưa nhập dòng nào:" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ImportErrors}" MaxHeight="240">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="error" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Nhập thật"
                            Classes="primary"
                            Command="{Binding ConfirmImportCommand}"
                            IsVisible="{Binding !ImportCompleted}"
                            IsEnabled="{Binding CanConfirmImport}" />
                    <Button Content="{Binding CancelButtonLabel}" Command="{Binding CancelImportCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    </Grid>

</UserControl>
