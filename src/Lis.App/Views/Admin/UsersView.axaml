<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lis.App.ViewModels.Admin"
             x:Class="Lis.App.Views.Admin.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid ColumnDefinitions="300,*" RowDefinitions="*">

        <!-- Cột trái: danh sách tài khoản -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,16,0">

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Tìm tài khoản" />
                <TextBox Text="{Binding FilterText}" PlaceholderText="Tên đăng nhập..." />
            </StackPanel>

            <Border Classes="table" Grid.Row="1">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="100,*,72">
                        <Border Grid.Column="0" Classes="th"><TextBlock Text="Tên đăng nhập" /></Border>
                        <Border Grid.Column="1" Classes="th"><TextBlock Text="Họ tên" /></Border>
                        <Border Grid.Column="2" Classes="th last"><TextBlock Text="Trạng thái" /></Border>
                    </Grid>
                    <ListBox Grid.Row="1" Classes="table" Name="UserList"
                             ItemsSource="{Binding FilteredUsers}"
                             SelectedItem="{Binding SelectedUser}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserListItemViewModel">
                                <Grid ColumnDefinitions="100,*,72">
                                    <Border Grid.Column="0" Classes="td"><TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Border>
                                    <Border Grid.Column="1" Classes="td"><TextBlock Text="{Binding FullName}" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="2" Classes="td last"><TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted" /></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Button Grid.Row="2" Content="+ Tài khoản mới" Command="{Binding NewUserCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        </Grid>

        <!-- Cột phải: form chỉnh sửa -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- Form -->
            <Border CornerRadius="{StaticResource RadiusCard}" Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="12">

                        <!-- Tên đăng nhập (read-only khi sửa) -->
                        <StackPanel>
                            <TextBlock Classes="label" Text="Tên đăng nhập" />
                            <TextBox Text="{Binding EditUsername}" IsEnabled="{Binding IsEditingNew}" />
                        </StackPanel>

                        <!-- Họ tên -->
                        <StackPanel>
                            <TextBlock Classes="label" Text="Họ tên" />
                            <TextBox Text="{Binding EditFullName}" />
                        </StackPanel>

                        <!-- Chức danh -->
                        <StackPanel>
                            <TextBlock Classes="label" Text="Chức danh" />
                            <TextBox Text="{Binding EditTitle}" />
                        </StackPanel>

                        <!-- Mật khẩu -->
                        <StackPanel>
                            <TextBlock Classes="label" Text="Mật khẩu" />
                            <TextBox Text="{Binding NewPassword}" PasswordChar="*" />
                            <TextBlock FontSize="10" Classes="muted" Text="Để trống nếu không đổi mật khẩu" />
                        </StackPanel>

                        <!-- Vai trò -->
                        <StackPanel>
                            <TextBlock Classes="label" Text="Vai trò" />
                            <StackPanel Spacing="4">
                                <CheckBox Content="Quản trị" IsChecked="{Binding EditRoleQuanTri}" />
                                <CheckBox Content="Tiếp nhận" IsChecked="{Binding EditRoleTiepNhan}" />
                                <CheckBox Content="Kỹ thuật viên" IsChecked="{Binding EditRoleKyThuatVien}" />
                                <CheckBox Content="Trưởng khoa" IsChecked="{Binding EditRoleTruongKhoa}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Trạng thái -->
                        <CheckBox Content="Đang dùng" IsChecked="{Binding EditActive}" />

                        <!-- Nút hành động -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Right">
                            <Button Content="Lưu" Classes="primary" Command="{Binding SaveUserCommand}" />
                            <Button Content="Hủy" Command="{Binding CancelCommand}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Lỗi -->
            <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />

        </Grid>

    </Grid>

</UserControl>
