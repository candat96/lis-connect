<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lis.App.ViewModels"
        xmlns:admin="using:Lis.App.Views.Admin"
        xmlns:catalog="using:Lis.App.Views.Catalog"
        xmlns:instruments="using:Lis.App.Views.Instruments"
        xmlns:reception="using:Lis.App.Views.Reception"
        xmlns:results="using:Lis.App.Views.Results"
        xmlns:settings="using:Lis.App.Views.Settings"
        xmlns:unmatched="using:Lis.App.Views.Unmatched"
        x:Class="Lis.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://LisConnect/Assets/app-icon.ico"
        Title="LIS Connect"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">

        <!-- Thanh trên: logo, menu ngang, người đang đăng nhập — nhường toàn bộ chiều rộng cho nội dung. -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource BrushPrimary}">
                        <TextBlock Text="XN" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LIS Connect" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <ListBox Grid.Column="1" Name="NavList"
                         Classes="nav top"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="2" Background="{StaticResource BrushMuted}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis">
                        <Run Text="👤 " /><Run Text="{Binding CurrentUser.User.FullName}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Nội dung -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20,14,20,16">
            <TextBlock Grid.Row="0" Classes="title" Text="{Binding PageTitle}" Margin="0,0,0,12" />

            <!-- Panel giữ DataContext=MainViewModel cho IsVisible; View bên trong tự đổi DataContext. -->
            <Panel Grid.Row="1" IsVisible="{Binding IsCatalogSelected}">
                <catalog:CatalogView DataContext="{Binding Catalog}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsReceptionSelected}">
                <reception:ReceptionView DataContext="{Binding Reception}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsResultsSelected}">
                <results:ResultsView DataContext="{Binding Results}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsSettingsSelected}">
                <settings:SettingsView DataContext="{Binding Settings}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsUnmatchedSelected}">
                <unmatched:UnmatchedView DataContext="{Binding Unmatched}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsInstrumentsSelected}">
                <instruments:InstrumentsView DataContext="{Binding Instruments}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsRawLogSelected}">
                <instruments:RawLogView DataContext="{Binding RawLog}" />
            </Panel>

            <Panel Grid.Row="1" IsVisible="{Binding IsUsersSelected}">
                <admin:UsersView DataContext="{Binding Users}" />
            </Panel>

            <StackPanel Grid.Row="1" IsVisible="{Binding IsPlaceholderSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Classes="muted" Text="Đang xây dựng" HorizontalAlignment="Center" FontSize="18" />
                <TextBlock Classes="muted" Text="Màn hình này sẽ có ở các bước tiếp theo." HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>

</Window>
