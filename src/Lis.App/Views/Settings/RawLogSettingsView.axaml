<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lis.App.ViewModels.Settings"
             x:Class="Lis.App.Views.Settings.RawLogSettingsView"
             x:DataType="vm:RawLogSettingsViewModel">

    <StackPanel Spacing="12">
        <Border CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Classes="heading" Text="Log thô" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Log thô ghi mọi byte trao đổi với máy xét nghiệm, lưu trên đĩa từng máy trạm. Tệp cũ hơn số ngày giữ được tự xóa khi mở phần mềm và 6 giờ một lần." />

                <Grid ColumnDefinitions="160,200" ColumnSpacing="16">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="label" Text="Giữ log (ngày)" />
                        <TextBox Text="{Binding KeepDaysText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="label" Text="Cảnh báo khi vượt (MB)" />
                        <TextBox Text="{Binding WarnMegabytesText}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding UsageText}" />
                    <TextBlock Classes="error" IsVisible="{Binding IsOverThreshold}" TextWrapping="Wrap"
                               Text="Dung lượng log đã vượt ngưỡng cảnh báo — giảm số ngày giữ hoặc kiểm tra đĩa." />
                    <TextBlock Classes="muted" Text="{Binding Folder, StringFormat='Thư mục: {0}'}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="success" Text="{Binding SuccessMessage}" IsVisible="{Binding SuccessMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Lưu" Command="{Binding SaveCommand}" />
                    <Button Content="Dọn ngay" Command="{Binding CleanNowCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>
