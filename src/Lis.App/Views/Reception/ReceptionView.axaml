<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lis.App.ViewModels.Reception"
             xmlns:catalog="using:Lis.Data.Catalog"
             xmlns:conv="using:Lis.App.Services.Converters"
             x:Class="Lis.App.Views.Reception.ReceptionView"
             x:DataType="vm:ReceptionViewModel">

    <!--
        Màn Tiếp nhận: một dòng người bệnh (bấm để mở hộp tìm / nhập mới), một dòng thông tin
        chỉ định, ô gõ mã dịch vụ, và MỘT bảng dịch vụ của phiếu — mỗi dòng có loại mẫu và
        barcode (điền ngay sau khi "Lưu và in tem").
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

        <!-- Người bệnh -->
        <Border Grid.Row="0" Classes="card" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Classes="label" Text="Người bệnh" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PatientSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" FontSize="15" Classes.muted="{Binding !HasPatient}" />
                <Button Grid.Column="2" Name="PatientButton" Content="Người bệnh (F2)" Classes="primary" Padding="14,6" />
                <Button Grid.Column="3" Content="Phiếu mới" Command="{Binding NewOrderCommand}" Padding="14,6" />
            </Grid>
        </Border>

        <!-- Thông tin chỉ định -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,2*" ColumnSpacing="8" IsEnabled="{Binding IsEditable}">
            <TextBox Grid.Column="0" Text="{Binding OrderingDoctor}" PlaceholderText="Bác sĩ chỉ định" />
            <TextBox Grid.Column="1" Text="{Binding OrderingDept}" PlaceholderText="Khoa / phòng" />
            <TextBox Grid.Column="2" Text="{Binding Diagnosis}" PlaceholderText="Chẩn đoán" />
        </Grid>

        <!-- Gõ mã dịch vụ -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBox Name="ServiceCodeBox" Text="{Binding ServiceCodeInput}" FontSize="15"
                     PlaceholderText="Gõ mã dịch vụ rồi Enter để thêm — hoặc gõ tên để tìm…" />
            <Border Classes="table" IsVisible="{Binding !!ServiceSuggestions.Count}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="120,*,140">
                        <Border Grid.Column="0" Classes="th"><TextBlock Text="Mã" /></Border>
                        <Border Grid.Column="1" Classes="th"><TextBlock Text="Tên dịch vụ" /></Border>
                        <Border Grid.Column="2" Classes="th last"><TextBlock Text="Loại" /></Border>
                    </Grid>
                    <ListBox Grid.Row="1" Classes="table" Name="SuggestionsList" ItemsSource="{Binding ServiceSuggestions}" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="catalog:ServiceInfo">
                                <Grid ColumnDefinitions="120,*,140">
                                    <Border Grid.Column="0" Classes="td"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" Classes="td"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="2" Classes="td last"><TextBlock Text="{Binding IsPanel, Converter={x:Static conv:PanelLabelConverter.Instance}}" Classes="muted" FontSize="12" /></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Bảng dịch vụ của phiếu, kèm barcode -->
        <Border Grid.Row="3" Classes="table">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="120,*,130,190,170,72">
                    <Border Grid.Column="0" Classes="th"><TextBlock Text="Mã" /></Border>
                    <Border Grid.Column="1" Classes="th"><TextBlock Text="Tên dịch vụ" /></Border>
                    <Border Grid.Column="2" Classes="th"><TextBlock Text="Loại" /></Border>
                    <Border Grid.Column="3" Classes="th"><TextBlock Text="Loại mẫu" /></Border>
                    <Border Grid.Column="4" Classes="th"><TextBlock Text="Barcode" /></Border>
                    <Border Grid.Column="5" Classes="th last"><TextBlock Text="" /></Border>
                </Grid>
                <Panel Grid.Row="1">
                    <TextBlock Classes="muted" Text="Chưa có dịch vụ nào — gõ mã dịch vụ ở ô trên rồi Enter."
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !SelectedServices.Count}" />
                    <ListBox Classes="table" Name="ServicesList" ItemsSource="{Binding SelectedServices}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectedServiceViewModel">
                                <Grid ColumnDefinitions="120,*,130,190,170,72">
                                    <Border Grid.Column="0" Classes="td"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" /></Border>
                                    <Border Grid.Column="1" Classes="td"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="2" Classes="td"><TextBlock Text="{Binding Loai}" Classes="muted" FontSize="12" /></Border>
                                    <Border Grid.Column="3" Classes="td"><TextBlock Text="{Binding SpecimenName}" TextWrapping="Wrap" /></Border>
                                    <Border Grid.Column="4" Classes="td">
                                        <Panel>
                                            <TextBlock Text="{Binding BarcodeText}" IsVisible="{Binding HasBarcode}" FontWeight="Bold" FontFamily="Consolas,Menlo,monospace" FontSize="15" Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BarcodeText}" IsVisible="{Binding !HasBarcode}" Classes="muted" FontStyle="Italic" FontSize="12" />
                                        </Panel>
                                    </Border>
                                    <Border Grid.Column="5" Classes="td input last">
                                        <Button Content="Xóa" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Padding="8,2" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Grid>
        </Border>

        <!-- Lỗi + Lưu -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <TextBlock Classes="success" Text="Đã lưu phiếu và in tem. Gõ dịch vụ hoặc bấm &quot;Phiếu mới&quot; để tiếp nhận người tiếp theo." IsVisible="{Binding IsSaved}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Name="SaveButton" Classes="primary" Content="Lưu và in tem (F9)" Command="{Binding SaveCommand}" Padding="18,9" FontSize="15" />
        </Grid>

    </Grid>

</UserControl>
