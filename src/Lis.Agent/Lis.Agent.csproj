<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Agent đặt ở máy tính cạnh máy xét nghiệm: nối COM/TCP với máy, đẩy kết quả lên Lis.Server,
       lấy chỉ định về trả lời khi máy hỏi. Chạy như dịch vụ Windows (tự chạy khi bật máy). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LisAgent</AssemblyName>
    <RootNamespace>Lis.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lis.Core\Lis.Core.csproj" />
    <ProjectReference Include="..\Lis.Data\Lis.Data.csproj" />
    <ProjectReference Include="..\Lis.Connections\Lis.Connections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

</Project>
