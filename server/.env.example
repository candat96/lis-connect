# Cổng API (web dev proxy /api tới đây)
PORT=8084
# CSDL master: danh sách phòng khám + agent
MASTER_DATABASE_URL=postgres://lis_user:CHANGE_ME@localhost:5433/lis_master
# CSDL từng phòng khám — {db} thay bằng tên CSDL của phòng khám
TENANT_DATABASE_URL_TEMPLATE=postgres://lis_user:CHANGE_ME@localhost:5433/{db}
# Khoá ký phiên đăng nhập web — đặt chuỗi ngẫu nhiên dài, không dùng giá trị mẫu
JWT_SECRET=CHANGE_ME
# Múi giờ của phòng khám khi lọc theo ngày (phút lệch UTC; Việt Nam = 420)
LOCAL_UTC_OFFSET_MINUTES=420
