{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src"],
  // Phải ghi đè `exclude` của tệp cha. Tệp cha loại `**/*.test.ts` để mã test
  // không lọt vào `dist/` và vào ảnh Docker; nhưng `exclude` được kế thừa, nên
  // nếu không đặt lại ở đây thì chính cấu hình dành riêng cho test lại không
  // kiểm một tệp test nào.
  "exclude": []
}
