{
  "name": "lis-connect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --workspace vitest.e2e.workspace.ts",
    "typecheck": "tsc -b --pretty && pnpm -r --if-present typecheck:tests && tsc -p tsconfig.e2e.json --pretty",
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "reflect-metadata": "0.2.2",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/testing": "11",
    "@nestjs/platform-express": "11",
    "supertest": "7.0.0",
    "@types/supertest": "6.0.2"
  }
}
