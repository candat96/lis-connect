{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "test"],
  // Phải ghi đè `exclude` của tsconfig.json. Tệp cha loại `**/*.test.ts` để mã test không lọt vào
  // `dist/` và vào ảnh Docker sản xuất; nhưng `exclude` được kế thừa, nên nếu không đặt lại ở đây
  // thì chính cấu hình dành riêng cho test lại không kiểm một tệp test nào — `pnpm typecheck` sẽ
  // báo sạch trong khi test có lỗi kiểu thật.
  "exclude": []
}
