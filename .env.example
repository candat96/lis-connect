# Sao chép thành .env rồi đổi mọi giá trị CHANGE_ME. Không đưa .env lên git.

# Mật khẩu PostgreSQL (dùng chung ở 3 dòng dưới — phải trùng nhau)
POSTGRES_PASSWORD=CHANGE_ME
Master__ConnectionString=Host=postgres;Port=5432;Database=lis_master;Username=lis_user;Password=CHANGE_ME
Tenants__ConnectionTemplate=Host=postgres;Port=5432;Database={db};Username=lis_user;Password=CHANGE_ME

# Khoá ký phiên đăng nhập: chuỗi ngẫu nhiên từ 24 ký tự (vd: openssl rand -base64 32)
Jwt__Secret=CHANGE_ME

# Mã thiết lập: nhập trên trang /thiet-lap để tạo phòng khám đầu tiên. Nếu đặt thì phải từ 16 ký tự trở lên (ngắn hơn, server không khởi động).
# Để trống thì server tự sinh một mã mỗi lần chạy và in ra log lúc khởi động (docker compose logs server).
SETUP_KEY=

# Cổng mở ra máy chủ (mặc định 5080) và địa chỉ gắn cổng.
# Mặc định 127.0.0.1: chỉ máy chủ này truy cập được (đi qua reverse proxy). Không dùng reverse proxy mà muốn máy khác
# trong mạng truy cập thẳng thì đặt LIS_BIND=0.0.0.0.
LIS_PORT=5080
LIS_BIND=127.0.0.1

# Chỉ đặt true khi server đứng sau reverse proxy tin cậy (nginx/caddy) và không mở cổng ra ngoài trực tiếp
Proxy__TrustForwardedHeaders=false

# Múi giờ phòng khám: độ lệch so với UTC tính bằng phút (420 = UTC+7). Server dùng giá trị này để chia "ngày" và tính tuổi.
LocalUtcOffsetMinutes=420
